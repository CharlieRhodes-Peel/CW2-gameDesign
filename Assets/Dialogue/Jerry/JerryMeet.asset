  RootNode:
    dialogueText: Hey there, you look fit and healthy, I lost my ball somewhere around
      here. I know it's a big ask but if you find it would you give it back to me?
    responses:
    - responseText: Sure!
      nextNode:
        dialogueText: Oh thank you so much!! Please come back with it. I miss sitting
          on it so much!
        responses:
        - responseText: '*Wave Goodbye*'
          nextNode:
            dialogueText: 
            responses: []
            onDialogue:
              m_PersistentCalls:
                m_Calls: []
        onDialogue:
