                m_ObjectArgumentAssemblyTypeName: 
                m_IntArgument: 0
                m_FloatArgument: 0
                m_StringArgument: 
                m_BoolArgument: 0
              m_CallState: 2
    - responseText: No thank you
      nextNode:
        dialogueText: Oh, that's no worry at all. Safe travels!
        responses:
        - responseText: Close
