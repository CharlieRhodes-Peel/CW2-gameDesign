  RootNode:
    dialogueText: Hello traveler, welcome to Moon Lake! What have you travelled here
      for?
    responses:
    - responseText: I wanna meet your ruler now.
      friendshipThreshold: 0
      friendshipLevelGives: -1
      nextNode:
        dialogueText: "We are ruled by the electric eels. The eel princess is the
          current monarch. I know she lives in the royal palace but I don\u2019t
          know how you can meet her. You should probably ask the guards."
        responses:
        - responseText: Thank You!
          friendshipThreshold: 0
          friendshipLevelGives: 0
