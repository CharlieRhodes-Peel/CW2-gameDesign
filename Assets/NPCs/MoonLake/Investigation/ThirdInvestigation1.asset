        onDialogue:
          m_PersistentCalls:
            m_Calls: []
      optionalNextDialogueTree: {fileID: 0}
    - responseText: Blah blah just tell me about who was working at night over the
        power outage.
      friendshipThreshold: 0
      friendshipLevelGives: -3
      nextNode:
        dialogueText: No one.
        responses:
        - responseText: Next
