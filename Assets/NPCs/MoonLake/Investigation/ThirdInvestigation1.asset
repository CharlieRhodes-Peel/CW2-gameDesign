  RootNode:
    dialogueText: Hello, are you here to investigate the electricity storage also?
    responses:
    - responseText: Yes. I am a journalist investigating the power outage. Do you
        know if anyone was working the night shift 2 days ago?
      friendshipThreshold: 0
      friendshipLevelGives: 3
      nextNode:
        dialogueText: Sorry but no one was working the night shift two days ago.
        responses:
        - responseText: Next
          friendshipThreshold: 0
          friendshipLevelGives: 0
