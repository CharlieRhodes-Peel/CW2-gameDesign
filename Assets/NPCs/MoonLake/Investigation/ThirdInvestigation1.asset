          optionalNextDialogueTree: {fileID: 11400000, guid: a4cd4887f0d6fd74e91d654345da8c33, type: 2}
        onDialogue:
          m_PersistentCalls:
            m_Calls: []
      optionalNextDialogueTree: {fileID: 0}
    - responseText: Who was working at night the other day, was it you, are you responsible
        for the power outage?
      friendshipThreshold: 0
      friendshipLevelGives: 1
      nextNode:
        dialogueText: Of course not. No one was working that night.
