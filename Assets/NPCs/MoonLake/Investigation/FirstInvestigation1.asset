          optionalNextDialogueTree: {fileID: 0}
        onDialogue:
          m_PersistentCalls:
            m_Calls: []
      optionalNextDialogueTree: {fileID: 0}
    - responseText: Do you know who did this?
      friendshipThreshold: 0
      nextNode:
        dialogueText: Well I heard a suspicious frog was seen around here before
          the power outage.
