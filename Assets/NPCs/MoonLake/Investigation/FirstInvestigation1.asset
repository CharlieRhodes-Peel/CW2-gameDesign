                m_Calls: []
          optionalNextDialogueTree: {fileID: 0}
        onDialogue:
          m_PersistentCalls:
            m_Calls: []
      optionalNextDialogueTree: {fileID: 0}
    - responseText: Was it you?
      friendshipThreshold: 0
      nextNode:
        dialogueText: What! Of course not.
