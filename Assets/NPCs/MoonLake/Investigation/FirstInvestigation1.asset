  RootNode:
    dialogueText: "Hey, you here about the power outage. It\u2019s got everyone worried.
      We need electricity for our work."
    responses:
    - responseText: What happened?
      friendshipThreshold: 0
      nextNode:
        dialogueText: A few days ago there was a huge power outage, everything stopped
          working and the princess ordered us to shelter at home.
