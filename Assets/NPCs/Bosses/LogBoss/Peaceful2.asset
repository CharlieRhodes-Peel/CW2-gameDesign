  RootNode:
    dialogueText: "Don\u2019t you agree that I am the most handsome log you\u2019ve
      ever seen?\r\nIt is my greatest wish to destroy the Princess of Moon Lake and
      preserve my rightful place as the most beautiful"
    responses:
    - responseText: Yes you are far too handsome to do any work, your servants should
        keep up on your duties for you, they are the ones who made you king anyway
      friendshipThreshold: 0
      friendshipLevelGives: 0
      nextNode:
        dialogueText: Great! Your first task is to find my special brooch. Its got
          my name on the back.
        responses:
        - responseText: Accept Quest
          friendshipThreshold: 0
          friendshipLevelGives: 0
          nextNode:
            dialogueText: 
            responses: []
            onDialogue:
              m_PersistentCalls:
                m_Calls: []
          optionalNextDialogueTree: {fileID: 0}
        onDialogue:
          m_PersistentCalls:
            m_Calls: []
      optionalNextDialogueTree: {fileID: 0}
    - responseText: "It shouldn\u2019t matter if you are the most beautiful, you
        are neglecting your duties as king. Maybe you can set aside your hatred and
        focus on making your people like you again"
      friendshipThreshold: 0
      friendshipLevelGives: 0
      nextNode:
        dialogueText: I suppose you have a point, I'll try to make everyone admire
          me again, but first can you find my special brooch? Its got my name on
          the back.
        responses:
        - responseText: Accept Quest
          friendshipThreshold: 0
          friendshipLevelGives: 0
          nextNode:
            dialogueText: 
            responses: []
            onDialogue:
              m_PersistentCalls:
                m_Calls: []
          optionalNextDialogueTree: {fileID: 0}
        - responseText: Decline Quest
          friendshipThreshold: 0
          friendshipLevelGives: 0
          nextNode:
            dialogueText: 
            responses: []
            onDialogue:
              m_PersistentCalls:
                m_Calls: []
          optionalNextDialogueTree: {fileID: 0}
        onDialogue:
          m_PersistentCalls:
            m_Calls: []
      optionalNextDialogueTree: {fileID: 0}
    onDialogue:
