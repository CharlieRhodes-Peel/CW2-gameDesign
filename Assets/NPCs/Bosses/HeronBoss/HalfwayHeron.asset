  RootNode:
    dialogueText: Hmm it seems you are a mighty warrior. You may speak.
    responses:
    - responseText: You are a cruel king, I will stop you and your cult from hurting
        more frogs! Continue Fight
      friendshipThreshold: -10
      friendshipLevelGives: -15
      nextNode:
        dialogueText: 
        responses: []
        onDialogue:
          m_PersistentCalls:
            m_Calls: []
      optionalNextDialogueTree: {fileID: 0}
    - responseText: Can you tell me why you hate Undergrowth?
      friendshipThreshold: 10
      friendshipLevelGives: 15
      nextNode:
        dialogueText: They are a lazy bunch of frogs. No discipline at all! It is
          only right and holy if I conquer their lands. A truly powerful leader is
          what they need.
        responses:
        - responseText: Next
          friendshipThreshold: 0
          friendshipLevelGives: 0
          nextNode:
            dialogueText: 
            responses: []
            onDialogue:
              m_PersistentCalls:
                m_Calls: []
          optionalNextDialogueTree: {fileID: 0}
        onDialogue:
          m_PersistentCalls:
            m_Calls: []
      optionalNextDialogueTree: {fileID: 11400000, guid: 1ef6ba67c57238946bfaab6fd4e7793b, type: 2}
    - responseText: I want to know more about you?
      friendshipThreshold: 0
      friendshipLevelGives: 0
      nextNode:
        dialogueText: I am The Heron. The most powerful ruler in the region. The
          frogs wished for a powerful leader to keep affairs in order. I fulfill
          my holy duty as church leader and ensure my subjects' protection from their
          innate irrational actions. Without me, they would struggle to do even the
          simplest tasks.
        responses:
        - responseText: Next
          friendshipThreshold: 0
          friendshipLevelGives: 0
          nextNode:
            dialogueText: 
            responses: []
            onDialogue:
              m_PersistentCalls:
                m_Calls: []
          optionalNextDialogueTree: {fileID: 0}
        onDialogue:
          m_PersistentCalls:
            m_Calls: []
      optionalNextDialogueTree: {fileID: 11400000, guid: 1ef6ba67c57238946bfaab6fd4e7793b, type: 2}
