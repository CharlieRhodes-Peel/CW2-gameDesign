  RootNode:
    dialogueText: Hello traveller.<0.3> </> Welcome to the neutral region, no wars
      here haha.<0.3> </>I'll be your guide. <0.3> </> You can find Moon Lake above,
      Undergrowth below and The Curch of The Heron to the right. <0.3> </> Safe travels!
    responses:
    - responseText: Thanks for the info!
      friendshipThreshold: 0
      friendshipLevelGives: 0
