  RootNode:
    dialogueText: The Heron has ordered a sacrifice, saying it will increase his
      holy power. I disagree though. I see you have a weapon, please help me stop
      the sacrifice.
    responses:
    - responseText: "How awful! i\u2019ll help you out"
      nextNode:
        dialogueText: "Thank you kind traveler! Come find me when you\u2019re done"
        responses:
        - responseText: End Conversation
          nextNode:
            dialogueText: 
            responses: []
            onDialogue:
              m_PersistentCalls:
                m_Calls: []
          optionalNextDialogueTree: {fileID: 0}
        onDialogue:
          m_PersistentCalls:
            m_Calls: []
      optionalNextDialogueTree: {fileID: 0}
    - responseText: Is this a setup?
      nextNode:
        dialogueText: "No no\u2026I just need help to stop the sacrifice, once it\u2019s
          been stopped I can sneak you into the church."
        responses:
        - responseText: End Conversation
