  RootNode:
    dialogueText: 'Bonk: What did you say to him? He looks hopeful for once!'
    responses:
    - responseText: Do you guys have a golden brooch?
      friendshipThreshold: 0
      nextNode:
        dialogueText: 'Zonk: Don''t even start with the brooch thing.<0.3> </>I swear
          it''s all he talks about.<0.3> </> I had one shift where he was just crying
          the whole time<0.3>.....</> Six hours.<0.3> </>It was for SIX<0.3> </>HOURS.'
        responses: []
        onDialogue:
          m_PersistentCalls:
            m_Calls:
            - m_Target: {fileID: 5401671782847404365, guid: d12dbacc4f9245b42b99410bfb782739, type: 3}
