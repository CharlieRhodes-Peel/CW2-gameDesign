    - responseText: Keep Reading
      friendshipThreshold: 0
      friendshipLevelGives: 0
      nextNode:
        dialogueText: 'There have been rumours of missing frogs, tangled in the vines
          and eaten! '
        responses:
        - responseText: Stop Reading
          friendshipThreshold: 0
          friendshipLevelGives: 0
          nextNode:
            dialogueText: 
            responses: []
            onDialogue:
              m_PersistentCalls:
                m_Calls: []
          optionalNextDialogueTree: {fileID: 0}
        - responseText: Keep Reading
          friendshipThreshold: 0
          friendshipLevelGives: 0
          nextNode:
            dialogueText: 'Please take care of the vines, your highness.


              Sincerely,


              Concerned
              Frog'
