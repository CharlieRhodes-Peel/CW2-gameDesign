  RootNode:
    dialogueText: Well then<0.3>...</> What are you here for?
    responses:
    - responseText: "I\u2019m here to meet your king."
      nextNode:
        dialogueText: Aren't we all? Heheh, I've been waiting 3 years for my appointment
          with him, he's so lazy!
        responses:
        - responseText: Can you tell me more about him?
          nextNode:
            dialogueText: 
