                m_Calls: []
          optionalNextDialogueTree: {fileID: 11400000, guid: cb06abbd9c8aba6af8859145daf14ec5, type: 2}
        - responseText: I see
          nextNode:
            dialogueText: I do suggest talking to the people around though, they're
              a lovely bunch. Speaking of which can you go and tell bobble
